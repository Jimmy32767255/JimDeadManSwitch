# Maintainer: Jimmy32767255 <Jimmy32767255@outlook.com>
#
# 发布新版本时：
#   1. 同步更新 pkgver 与 Cargo.toml 中的 version
#   2. 提交并推送所有改动（tag 必须包含 LICENSE，否则 package() 会失败）
#   3. git tag -a "v$pkgver" -m "dmsw $pkgver" && git push origin "v$pkgver"
#   4. 在本目录运行 makepkg --printsrcinfo > .SRCINFO
#
# 提交到 AUR 时，将本目录下的 PKGBUILD 与 .SRCINFO 推送到 AUR 仓库即可。

pkgname=dmsw
pkgver=2.1.0
pkgrel=1
pkgdesc="GNU/Linux dead man's switch: run commands on key timeouts, key releases, or missing processes"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/Jimmy32767255/JimDeadManSwitch"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked
}

build() {
  cd "$pkgname"
  cargo build --release --frozen
}

check() {
  cd "$pkgname"
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 systemd/dmsw.service "$pkgdir/usr/lib/systemd/user/dmsw.service"
  install -Dm644 systemd/dmsw@.service "$pkgdir/usr/lib/systemd/system/dmsw@.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
